<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso para acceder a fotos en Android 13 (API 33) y superior -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.APP_CAPSTONE"
        tools:targetApi="31"
        android:networkSecurityConfig="@xml/network_security_config">


        <!-- LoginActivity será la primera pantalla -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.APP_CAPSTONE">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🏠 Nueva pantalla principal (main_app.xml) -->
        <activity
            android:name=".MainAppActivity"
            android:exported="false" />

        <!-- 🔹 Pantalla de login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- Pantalla principal -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Pantalla de registro -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <activity android:name=".ProfileActivity" />


    </application>
</manifest>
