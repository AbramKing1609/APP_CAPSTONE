<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Flecha y Título Fijos en la parte superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#333333"/>

        <TextView
            android:id="@+id/tvTitleCalendars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calendario"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/containerSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CALENDARIO INTERACTIVO (CalendarView) con estilo mejorado -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:layout_marginBottom="20dp">
                <!-- Se ha aumentado el radio y la elevación para un efecto más "flotante" -->

                <CalendarView
                    android:id="@+id/calendarView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"

                    android:dateTextAppearance="@style/TextAppearance.AppCompat.Medium"
                    android:weekDayTextAppearance="@style/TextAppearance.AppCompat.Small"

                    android:focusedMonthDateColor="#333333"
                    android:weekSeparatorLineColor="@android:color/transparent"

                    android:selectedWeekBackgroundColor="#E0F7FA"
                    android:selectedDateVerticalBar="@color/colorPrimary"

                    android:minDate="01/01/2021"
                    android:maxDate="31/12/2025"
                    android:firstDayOfWeek="2"
                    android:showWeekNumber="false" />
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/tvTitleSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cronograma"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="16dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
