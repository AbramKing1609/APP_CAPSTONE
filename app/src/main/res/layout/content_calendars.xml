<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Flecha y Título Fijos en la parte superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#03DAC5"/>

        <TextView
            android:id="@+id/tvTitleCalendars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calendario"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_extrabold"
            android:textColor="#000000"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/containerSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CALENDARIO INTERACTIVO (CalendarView) con estilo mejorado -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FAFAFA">

                <CalendarView
                    android:id="@+id/calendarView"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:padding="16dp"
                    android:focusedMonthDateColor="#03DAC5"
                    android:unfocusedMonthDateColor="#9E9E9E"
                    android:weekSeparatorLineColor="@android:color/transparent"
                    android:selectedWeekBackgroundColor="#E3F2FD"
                    android:minDate="01/01/2021"
                    android:maxDate="31/12/2025"
                    android:firstDayOfWeek="2"
                    android:showWeekNumber="false" />
            </androidx.cardview.widget.CardView>

            <!-- 🔹 NUEVO: FILTRO POR ESTADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filtrar por estado:"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:layout_marginEnd="12dp" />

                <Spinner
                    android:id="@+id/spinnerEstadoFilter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:padding="12dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTitleSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cronograma"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/montserrat_extrabold"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>