<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitlePagos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Historial de Pagos"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPagos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvTitlePagos"
        android:layout_above="@+id/btnBackPagos" />

    <TextView
        android:id="@+id/tvEmptyPagos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No hay pagos registrados"
        android:textSize="18sp"
        android:gravity="center"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnBackPagos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Volver" />

</RelativeLayout>