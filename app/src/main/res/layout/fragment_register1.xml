<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Campo Nombre -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilName"
            style="@style/Widget.App.TextInputLayout.Rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:errorEnabled="true">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre completo"
                android:inputType="textCapWords"
                android:fontFamily="@font/comfortaa"
                android:textColor="#1A232A"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Apellido -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLastName"
            style="@style/Widget.App.TextInputLayout.Rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:errorEnabled="true">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Apellido completo"
                android:inputType="textCapWords"
                android:fontFamily="@font/comfortaa"
                android:textColor="#1A232A"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo DNI -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDni"
            style="@style/Widget.App.TextInputLayout.Rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:errorEnabled="true">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="DNI"
                android:inputType="number"
                android:maxLength="8"
                android:fontFamily="@font/comfortaa"
                android:textColor="#1A232A"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Edad -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAge"
            style="@style/Widget.App.TextInputLayout.Rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:errorEnabled="true">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Edad"
                android:inputType="number"
                android:fontFamily="@font/comfortaa"
                android:textColor="#1A232A"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Celular -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCelular"
            style="@style/Widget.App.TextInputLayout.Rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:errorEnabled="true">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCelular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Celular"
                android:inputType="phone"
                android:fontFamily="@font/comfortaa"
                android:textColor="#1A232A"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Correo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.App.TextInputLayout.Rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:errorEnabled="true">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Correo"
                android:inputType="textEmailAddress"
                android:fontFamily="@font/comfortaa"
                android:textColor="#1A232A"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Distrito (AutoCompleteTextView) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDistrito"
            style="@style/Widget.App.TextInputLayout.Rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:errorEnabled="true"
            app:endIconMode="dropdown_menu">
            <AutoCompleteTextView
                android:id="@+id/actvDistrito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ciudad / Distrito"
                android:inputType="text"
                android:paddingTop="20dp"
                android:textSize="16sp"
                android:fontFamily="@font/comfortaa"
                android:textColor="#1A232A"/>/> <!-- Ajuste: Espaciado a 20dp y tamaño de fuente uniforme -->
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Nacionalidad (AutoCompleteTextView) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNacionalidad"
            style="@style/Widget.App.TextInputLayout.Rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:errorEnabled="true"
            app:endIconMode="dropdown_menu">
            <AutoCompleteTextView
                android:id="@+id/actvNacionalidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nacionalidad"
                android:inputType="text"
                android:paddingTop="20dp"
                android:textSize="16sp"
                android:fontFamily="@font/comfortaa"
                android:textColor="#1A232A"/>/> <!-- Ajuste: Espaciado a 20dp y tamaño de fuente uniforme -->
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
