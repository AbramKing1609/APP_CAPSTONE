<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- ============================================== -->
    <!-- 1. ENCABEZADO SUPERIOR VERDE/CIAN (FIJO) -->
    <!-- ============================================== -->
    <FrameLayout
        android:id="@+id/fixedTopHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/header_top_background"
        android:paddingTop="10dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:text="Dr_Pe"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_extrabold"
            android:textColor="#FFFFFF" />
    </FrameLayout>

    <!-- ============================================== -->
    <!-- 2. CONTENIDO PRINCIPAL DEL LOGIN -->
    <!-- ============================================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@android:color/white"
        android:padding="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Flecha hacia atrás en posición superior del contenido -->
            <ImageView
                android:id="@+id/btnBackLogin"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:src="@drawable/ic_arrow_back"
                android:tint="#03DAC5"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentTop="true"
                android:layout_marginTop="16dp">

                <!-- Logo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="32dp">

                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:src="@drawable/ic_register_app"
                        android:contentDescription="@string/app_name" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="¡Bienvenido!"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="#000000"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/montserrat_extrabold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ingrese sus credenciales para continuar"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:textColor="#9E9E9E"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/montserrat_bold" />
                </LinearLayout>

                <!-- Usuario / Campo colegiatura -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUsername"
                    style="@style/Widget.App.TextInputLayout.Rounded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ingrese su N° de colegiatura"
                        android:inputType="textEmailAddress"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#212121"
                        android:textSize="16sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Contraseña -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.App.TextInputLayout.Rounded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    app:errorEnabled="true"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="#03DAC5">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Contraseña"
                        android:inputType="textPassword"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#212121"
                        android:textSize="16sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón login -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Ingresar"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#03DAC5"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:elevation="4dp"/>

                <!-- Enlace a registro -->
                <TextView
                    android:id="@+id/tvGoRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿No tienes cuenta? Regístrate aquí"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="#03DAC5"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:fontFamily="@font/montserrat_bold"/>

                <TextView
                    android:id="@+id/tvOlvideMiContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Olvide mi contraseña"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="#03DAC5"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:fontFamily="@font/montserrat_bold"/>

            </LinearLayout>
        </RelativeLayout>
    </ScrollView>

    <!-- ============================================== -->
    <!-- 3. PIE DE PÁGINA INFERIOR VERDE/CIAN (FIJO) -->
    <!-- ============================================== -->
    <FrameLayout
        android:id="@+id/fixedBottomFooter"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:background="@drawable/footer_bottom_background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Sistema Médico"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_extrabold"
            android:textColor="#FFFFFF" />
    </FrameLayout>
</LinearLayout>