<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitlePatients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis Pacientes"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/btnAddPatient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTitlePatients"
        android:layout_alignParentEnd="true"
        android:text="Agregar"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPatients"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btnAddPatient"
        android:layout_above="@+id/btnBackPatients" />

    <TextView
        android:id="@+id/tvEmptyPatients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No hay pacientes registrados"
        android:textSize="18sp"
        android:gravity="center"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnBackPatients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Volver" />

</RelativeLayout>