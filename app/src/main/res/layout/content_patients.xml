<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5">

    <!-- Título principal -->
    <TextView
        android:id="@+id/tvTitlePatients"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notificaciones"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="16dp" />

    <!-- Lista de notificaciones -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/containerPatients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ejemplo de tarjeta de notificación -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/ic_calendar"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvPatientTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nueva cita registrada"
                    android:textStyle="bold"
                    android:textColor="#1EC8A3"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvPatientMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="El paciente Juan Pérez ha reservado una cita para el lunes a las 10:00 a.m."
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvPatientTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hace 5 minutos"
                    android:textColor="#999999"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
