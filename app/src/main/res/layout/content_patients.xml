<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Parte superior blanca (título + búsqueda) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="40dp">

        <!-- Flecha y título -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#03DAC5" />

            <TextView
                android:id="@+id/tvTitlePatients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pacientes"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/montserrat_extrabold"
                android:textColor="#000000"
                android:layout_marginStart="12dp" />

            <!-- 🔹 BOTÓN DE HISTORIAL en la esquina superior derecha -->
            <ImageButton
                android:id="@+id/btnHistoryPatients"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_history"
                android:tint="#03DAC5"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Historial de pacientes" />
        </LinearLayout>

        <!-- Barra de búsqueda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/background_edittext"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:tint="#03DAC5" />

            <EditText
                android:id="@+id/etSearchPatients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Buscar por nombre o palabra clave"
                android:background="@android:color/transparent"
                android:paddingStart="12dp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/montserrat_bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fondo degradado verde curvo con lista de pacientes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_notifications_curved"
        android:layout_marginTop="160dp"
        android:paddingHorizontal="20dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/containerPatients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="55dp"
                android:paddingBottom="80dp" />
        </ScrollView>
    </LinearLayout>

    <!-- Ícono central flotante -->
    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="130dp"
        android:src="@drawable/ic_notifications"
        android:background="@drawable/bg_icon_circle"
        android:padding="16dp"
        android:elevation="8dp"
        android:tint="#FFFFFF" />
</FrameLayout>