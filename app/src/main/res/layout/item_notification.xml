<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_notification_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical"
    android:elevation="4dp">

    <!-- 🧾 Información de la notificación -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNotificationName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Brayan Calderon Quevedo"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvNotificationType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuevo Paciente"
            android:textColor="#C4FFF5"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 👥 Ícono de notificación (Stacked for visual effect) -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp">

        <!-- Back/Shadow icon (offset and slightly tinted for depth) -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/ic_patients"
            android:tint="#C4FFF5" /> <!-- Lighter tint for the background effect -->

        <!-- Front/Main icon -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_patients"
            android:tint="#FFFFFF" />
    </FrameLayout>
</LinearLayout>
