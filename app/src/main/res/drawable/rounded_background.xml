<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Color de fondo -->
    <solid android:color="@color/white"/> <!-- Cambia el color según necesites -->
    <!-- Esquinas redondeadas -->
    <corners android:radius="16dp"/> <!-- Ajusta el radio para cambiar el redondeo -->
    <!-- Opcional: Borde -->
    <stroke
        android:width="1dp"
        android:color="@color/peru_red"/> <!-- Cambia el color y ancho del borde si lo deseas -->
</shape>