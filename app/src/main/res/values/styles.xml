<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo de botón que ya tenías -->
    <style name="RoundedButton" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Nuevo estilo para los campos de texto con apariencia de 'FilledBox' y bordes redondeados -->
    <style name="Widget.App.TextInputLayout.Rounded" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <!-- Define la apariencia de la forma (esquinas redondeadas) -->
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.RoundedCorners</item>
        <!-- Opcional: Color del fondo relleno. Usar un color claro o transparente. -->
        <!-- Asegúrate de definir @color/inputBackground en colors.xml o usar un color predefinido -->
        <item name="boxBackgroundColor">#F5F5F5</item> <!-- Gris muy claro para el fondo (como el de la imagen) -->
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/gray</item>
    </style>

    <!-- Definición de la apariencia de la forma (si necesitas un control más fino sobre las esquinas) -->
    <style name="ShapeAppearance.App.RoundedCorners" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

</resources>
